---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import FeaturedGrid from "../components/FeaturedGrid.astro";
import Contact from "../components/Contact.astro";
import { t } from "../i18n/pt";
---
<Base title={t.meta.title} description={t.meta.description}>
  <Hero />
  <section aria-labelledby="destaques-titulo" class="py-12">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 id="destaques-titulo" class="font-display text-2xl font-medium">{t.projects.title}</h2>
      <a href="/projetos" class="font-mono text-sm text-blue underline-offset-4 hover:underline">{t.projects.all} →</a>
    </div>
    <div class="mt-8"><FeaturedGrid /></div>
  </section>
  <About />
  <Contact />
</Base>
