---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import FeaturedGrid from "../../components/FeaturedGrid.astro";
import RepoList from "../../components/RepoList.astro";
import { getOtherRepos } from "../../lib/github";
import { hasPage } from "../../lib/projects";
import { t } from "../../i18n/pt";

const repos = await getOtherRepos();
const count = (await getCollection("projetos")).filter(hasPage).length;
---
<Base title="Projetos · Márcio Ferreira Lima" description="Projetos de backend, DevOps e infraestrutura de Márcio Ferreira Lima.">
  <header class="pt-10 pb-8">
    <p class="font-mono text-sm text-brown">~/marciodev $ ls projetos</p>
    <h1 class="mt-2 font-display text-4xl font-medium tracking-tight">Projetos</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">Os <span data-case-count>{count}</span> primeiros têm estudo de caso completo. Abaixo, o restante do que está público no meu GitHub.</p>
  </header>
  <section aria-labelledby="destaques-titulo">
    <h2 id="destaques-titulo" class="sr-only">{t.projects.title}</h2>
    <FeaturedGrid />
  </section>
  <section aria-labelledby="outros-titulo" class="mt-16">
    <h2 id="outros-titulo" class="font-display text-2xl font-medium">Outros projetos</h2>
    <p class="mt-2 text-sm text-muted">Atualizado automaticamente a partir do GitHub.</p>
    <div class="mt-6"><RepoList repos={repos} /></div>
  </section>
</Base>
