---
import { t } from "../i18n/pt";
import { banners } from "./banners";

interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
}
const { slug, title, summary, tags } = Astro.props;
const Banner = banners[slug];
---
<article data-project-card class="card group relative flex w-full flex-col rounded-2xl border border-border bg-surface p-2 transition-colors hover:border-purple">
  {Banner && <div class="overflow-hidden rounded-xl"><Banner /></div>}
  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-display text-xl font-medium">
      <a href={`/projetos/${slug}`} class="after:absolute after:inset-0 focus-visible:outline-none">{title}</a>
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-muted">{summary}</p>
    <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs" aria-label="Tecnologias">
      {tags.map((tag) => <li class="rounded-md bg-tag px-2 py-0.5 text-brown">{tag}</li>)}
    </ul>
    <p class="mt-auto pt-5 font-mono text-sm text-purple" aria-hidden="true">{t.projects.details} →</p>
  </div>
</article>
<style>
  .card:has(a:focus-visible) { outline: 2px solid var(--c-blue); outline-offset: 3px; }
</style>
