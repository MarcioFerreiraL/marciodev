<button
  type="button"
  data-theme-toggle
  aria-label="Alternar tema"
  aria-pressed="false"
  class="inline-flex size-10 items-center justify-center rounded-lg border border-border text-text hover:bg-surface"
>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>
<script is:inline>
  (() => {
    const btn = document.currentScript.previousElementSibling;
    const sync = () => btn.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "light"));
    sync();
    btn.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
      sync();
    });
  })();
</script>
