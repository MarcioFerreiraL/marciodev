---
import ThemeToggle from "./ThemeToggle.astro";
import { t } from "../i18n/pt";
---
<a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-purple focus:px-4 focus:py-2 focus:text-on-purple">{t.nav.skip}</a>
<header class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-5 sm:px-6">
  <a href="/" class="font-mono text-sm font-medium"><span class="text-brown">~/</span>marciodev</a>
  <nav aria-label="Principal" class="flex items-center gap-1 text-sm sm:gap-4">
    <a href="/projetos" class="rounded-md px-2 py-1 text-muted hover:text-text">{t.nav.projetos}</a>
    <a href="/#sobre" class="hidden rounded-md px-2 py-1 text-muted hover:text-text sm:inline">{t.nav.sobre}</a>
    <a href="/#contato" class="rounded-md px-2 py-1 text-muted hover:text-text">{t.nav.contato}</a>
    <ThemeToggle />
  </nav>
</header>
