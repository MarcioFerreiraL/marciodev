---
import { site, t } from "../i18n/pt";
---
<section class="grid items-center gap-10 pt-10 pb-16 md:grid-cols-[1fr_auto] md:pt-16">
  <div>
    <p class="font-mono text-sm text-brown">{t.hero.prompt}</p>
    <h1 class="mt-3 font-display text-4xl font-medium tracking-tight sm:text-5xl">{site.name}</h1>
    <p class="mt-4 max-w-xl text-lg text-muted">{t.hero.line} · {t.hero.place}</p>
    <p class="mt-6 font-mono text-sm">
      <span class="text-muted">{t.hero.interestsLabel}: </span><span class="text-brown">{t.hero.interests}</span>
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/curriculo-pt.pdf" download class="rounded-lg bg-purple px-5 py-2.5 text-sm font-medium text-on-purple hover:opacity-90">{t.hero.cvPt}</a>
      <a href="/curriculo-en.pdf" download class="rounded-lg border border-border px-5 py-2.5 text-sm font-medium hover:bg-surface">{t.hero.cvEn}</a>
      <a href={site.github} class="px-2 text-sm text-blue underline-offset-4 hover:underline">GitHub</a>
      <a href={site.linkedin} class="px-2 text-sm text-blue underline-offset-4 hover:underline">LinkedIn</a>
    </div>
  </div>
  <div class="order-first md:order-none">
    <slot name="photo">
      <div aria-hidden="true" class="flex size-36 items-center justify-center rounded-2xl border border-border bg-surface font-display text-4xl text-purple md:size-56">MF</div>
    </slot>
  </div>
</section>
