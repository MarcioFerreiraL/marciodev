---
import { site, t } from "../i18n/pt";
---
<!-- No celular a foto fica ao lado do nome; no desktop, ao lado de todo o bloco. -->
<section class="grid grid-cols-[1fr_auto] items-center gap-x-5 pt-10 pb-16 sm:gap-x-10 md:grid-rows-[auto_auto] md:pt-16">
  <div class="col-start-1 row-start-1 md:self-end">
    <p class="font-mono text-sm text-brown">{t.hero.prompt}</p>
    <h1 class="mt-3 font-display text-4xl font-medium tracking-tight sm:text-5xl">{site.name}</h1>
  </div>
  <div class="col-start-2 row-start-1 md:row-span-2">
    <slot name="photo">
      <div aria-hidden="true" class="flex size-24 items-center justify-center rounded-full border border-border bg-surface font-display text-4xl text-purple sm:size-36 md:size-56">MF</div>
    </slot>
  </div>
  <div class="col-span-2 row-start-2 md:col-span-1 md:self-start">
    <p class="mt-4 max-w-xl text-lg text-muted">{t.hero.line} · {t.hero.place}</p>
    <p class="mt-6 font-mono text-sm">
      <span class="text-muted">{t.hero.interestsLabel}: </span><span class="text-brown">{t.hero.interests}</span>
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      {site.cvReady ? (
        <>
          <a href="/curriculo-pt.pdf" download="Marcio-Ferreira-Lima-Curriculo.pdf" class="rounded-lg bg-purple px-5 py-2.5 text-sm font-medium text-on-purple hover:opacity-90">{t.hero.cvPt}</a>
          <a href="/curriculo-en.pdf" download="Marcio-Ferreira-Lima-Resume.pdf" class="rounded-lg border border-border px-5 py-2.5 text-sm font-medium hover:bg-surface">{t.hero.cvEn}</a>
          <a href={site.github} class="px-2 text-sm text-blue underline-offset-4 hover:underline">GitHub</a>
          <a href={site.linkedin} class="px-2 text-sm text-blue underline-offset-4 hover:underline">LinkedIn</a>
        </>
      ) : (
        <>
          <a href={site.github} class="rounded-lg bg-purple px-5 py-2.5 text-sm font-medium text-on-purple hover:opacity-90">GitHub</a>
          <a href={site.linkedin} class="rounded-lg border border-border px-5 py-2.5 text-sm font-medium hover:bg-surface">LinkedIn</a>
        </>
      )}
    </div>
  </div>
</section>
