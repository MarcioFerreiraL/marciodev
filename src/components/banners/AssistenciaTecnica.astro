---
import Frame from "./Frame.astro";
---
<Frame id="assistencia" label="Ilustração: notebook em reparo com chave inglesa e chave de fenda, engrenagens e fluxo de estados da ordem de serviço">
  <!-- notebook -->
  <g>
    <rect x="250" y="70" width="300" height="190" rx="14" class="fill-text" />
    <rect x="264" y="84" width="272" height="162" rx="6" class="fill-surface" />
    <path d="M220 262h360l-22 30H242z" class="fill-muted" />
    <rect x="370" y="262" width="60" height="8" rx="4" class="fill-border" />
    <!-- tela: chave e fenda cruzadas -->
    <g transform="translate(400 165) rotate(45)">
      <rect x="-8" y="-60" width="16" height="96" rx="6" class="fill-brown" />
      <path d="M-22 -78a22 22 0 1 0 44 0l-10 0v12h-24v-12z" class="fill-brown" />
    </g>
    <g transform="translate(400 165) rotate(-45)">
      <rect x="-12" y="8" width="24" height="52" rx="8" class="fill-purple" />
      <rect x="-4" y="-62" width="8" height="72" class="fill-muted" />
      <path d="M-4 -62h8l-4 -10z" class="fill-muted" />
    </g>
  </g>
  <!-- fluxo de estados -->
  <g font-family="JetBrains Mono, monospace" font-size="13" font-weight="500">
    {[
      { x: 110, label: "ABERTA", cls: "fill-blue" },
      { x: 300, label: "ORÇAMENTO", cls: "fill-brown" },
      { x: 490, label: "EM REPARO", cls: "fill-purple" },
      { x: 680, label: "ENTREGUE", cls: "fill-blue" },
    ].map((s, i) => (
      <g>
        <rect x={s.x - 74} y="330" width="148" height="40" rx="20" class={s.cls} />
        <text x={s.x} y="355" text-anchor="middle" class="fill-surface">{s.label}</text>
        {i < 3 && <path d={`M${s.x + 80} 350h26l-8 -7M${s.x + 106} 350l-8 7`} class="fill-none stroke-text" stroke-width="3" stroke-linecap="round" />}
      </g>
    ))}
  </g>
  <!-- engrenagens -->
  {[
    { x: 120, y: 120, r: 40, cls: "fill-purple" },
    { x: 178, y: 196, r: 26, cls: "fill-blue" },
    { x: 660, y: 110, r: 34, cls: "fill-brown" },
  ].map((g) => (
    <g transform={`translate(${g.x} ${g.y})`}>
      {Array.from({ length: 8 }, (_, i) => <rect x={-g.r * 0.2} y={-g.r * 1.3} width={g.r * 0.4} height={g.r * 0.5} rx="3" transform={`rotate(${i * 45})`} class={g.cls} />)}
      <circle r={g.r} class={g.cls} /><circle r={g.r * 0.4} class="fill-tag" />
    </g>
  ))}
  <!-- prancheta de OS -->
  <g transform="translate(620 170) rotate(8)">
    <rect x="0" y="0" width="110" height="130" rx="10" class="fill-surface stroke-text" stroke-width="3" />
    <rect x="35" y="-10" width="40" height="20" rx="6" class="fill-brown" />
    <text x="16" y="38" font-family="JetBrains Mono, monospace" font-size="14" font-weight="500" class="fill-purple">OS #42</text>
    <rect x="16" y="54" width="78" height="8" rx="4" class="fill-border" />
    <rect x="16" y="72" width="60" height="8" rx="4" class="fill-border" />
    <path d="M18 100l8 8 14-16" class="fill-none stroke-blue" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="48" y="98" width="44" height="8" rx="4" class="fill-border" />
  </g>
  <!-- chip e parafusos -->
  <g transform="translate(40 250)">
    <rect x="0" y="0" width="56" height="56" rx="8" class="fill-text" />
    <rect x="14" y="14" width="28" height="28" rx="4" class="fill-brown" />
    {[8, 22, 36].map((o) => <g class="fill-muted"><rect x={o + 4} y="-8" width="4" height="8" /><rect x={o + 4} y="56" width="4" height="8" /><rect x="-8" y={o + 4} width="8" height="4" /><rect x="56" y={o + 4} width="8" height="4" /></g>)}
  </g>
  {[[220, 40], [580, 40], [760, 250]].map(([x, y]) => (
    <g transform={`translate(${x} ${y})`}><circle r="10" class="fill-muted" /><path d="M-6 0h12" class="stroke-tag" stroke-width="3" /></g>
  ))}
</Frame>
