---
import Frame from "./Frame.astro";
---
<Frame id="clinics" label="Ilustração: celular comparando preços de exames, pinos de mapa de clínicas e conversa no WhatsApp">
  <!-- cidade ao fundo -->
  <g class="fill-border">
    <rect x="0" y="330" width="800" height="90" />
    <rect x="30" y="270" width="60" height="60" /><rect x="100" y="240" width="46" height="90" /><rect x="156" y="285" width="70" height="45" />
    <rect x="560" y="255" width="54" height="75" /><rect x="624" y="280" width="80" height="50" /><rect x="714" y="235" width="56" height="95" />
  </g>
  <!-- clínicas com cruz -->
  <g>
    <rect x="236" y="250" width="90" height="80" rx="6" class="fill-surface stroke-brown" stroke-width="3" />
    <rect x="270" y="296" width="22" height="34" class="fill-brown" />
    <rect x="276" y="258" width="10" height="28" rx="2" class="fill-purple" /><rect x="267" y="267" width="28" height="10" rx="2" class="fill-purple" />
    <rect x="474" y="262" width="76" height="68" rx="6" class="fill-surface stroke-brown" stroke-width="3" />
    <rect x="503" y="270" width="8" height="22" rx="2" class="fill-blue" /><rect x="496" y="277" width="22" height="8" rx="2" class="fill-blue" />
    <rect x="500" y="302" width="24" height="28" class="fill-brown" />
  </g>
  <!-- celular central -->
  <g>
    <rect x="320" y="40" width="160" height="300" rx="22" class="fill-text" />
    <rect x="330" y="56" width="140" height="268" rx="14" class="fill-surface" />
    <rect x="374" y="46" width="52" height="6" rx="3" class="fill-muted" />
    <rect x="344" y="72" width="112" height="16" rx="8" class="fill-tag" />
    <circle cx="354" cy="80" r="4" class="fill-muted" />
    {[0, 1, 2].map((i) => (
      <g transform={`translate(0 ${i * 72})`}>
        <rect x="342" y="100" width="116" height="60" rx="10" class={i === 0 ? "fill-purple" : "fill-tag"} />
        <rect x="352" y="112" width="52" height="7" rx="3" class={i === 0 ? "fill-surface" : "fill-muted"} />
        <rect x="352" y="125" width="34" height="6" rx="3" class={i === 0 ? "fill-surface" : "fill-border"} />
        <text x="448" y="148" text-anchor="end" font-family="JetBrains Mono, monospace" font-size="15" font-weight="500" class={i === 0 ? "fill-surface" : "fill-brown"}>{["R$ 90", "R$ 110", "R$ 120"][i]}</text>
      </g>
    ))}
  </g>
  <!-- pinos de mapa -->
  <g>
    <path d="M200 70c-24 0-42 18-42 41 0 31 42 71 42 71s42-40 42-71c0-23-18-41-42-41z" class="fill-purple" />
    <circle cx="200" cy="110" r="17" class="fill-surface" />
    <rect x="196" y="100" width="8" height="20" rx="2" class="fill-purple" /><rect x="190" y="106" width="20" height="8" rx="2" class="fill-purple" />
    <path d="M612 120c-17 0-30 13-30 29 0 22 30 50 30 50s30-28 30-50c0-16-13-29-30-29z" class="fill-blue" />
    <circle cx="612" cy="148" r="11" class="fill-surface" />
  </g>
  <!-- conversa -->
  <g>
    <path d="M520 52h150a16 16 0 0 1 16 16v44a16 16 0 0 1-16 16h-110l-24 20v-20h-16a16 16 0 0 1-16-16V68a16 16 0 0 1 16-16z" class="fill-surface stroke-blue" stroke-width="3" />
    <rect x="536" y="72" width="96" height="8" rx="4" class="fill-blue" />
    <rect x="536" y="90" width="124" height="8" rx="4" class="fill-border" />
  </g>
  <!-- tubo de ensaio -->
  <g transform="rotate(-18 110 170)">
    <rect x="96" y="120" width="28" height="96" rx="14" class="fill-surface stroke-brown" stroke-width="3" />
    <rect x="99" y="170" width="22" height="43" rx="11" class="fill-purple" />
    <rect x="90" y="114" width="40" height="10" rx="4" class="fill-brown" />
  </g>
  <!-- estrelas de avaliação -->
  <g class="fill-brown">
    {[0, 1, 2, 3, 4].map((i) => (
      <path transform={`translate(${612 + i * 28} 228) scale(0.55)`} d="M20 0l6 13 14 2-10 10 2 14-12-7-12 7 2-14L0 15l14-2z" />
    ))}
  </g>
  <!-- batimento, coração e moeda -->
  <path d="M20 40h50l12-22 16 44 14-30 10 8h60" class="fill-none stroke-blue" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M732 300c-8-12-30-8-30 9 0 15 30 31 30 31s30-16 30-31c0-17-22-21-30-9z" class="fill-purple" />
  <g>
    <circle cx="262" cy="64" r="22" class="fill-brown" />
    <circle cx="262" cy="64" r="15" class="fill-none stroke-tag" stroke-width="3" />
    <text x="262" y="70" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="16" font-weight="500" class="fill-tag">$</text>
  </g>
  <g class="fill-none stroke-muted" stroke-width="3" stroke-linecap="round">
    <path d="M700 30l8 8M720 22v12M736 34l-8 6" />
  </g>
</Frame>
