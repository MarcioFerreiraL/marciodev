---
// Moldura comum dos banners: fundo, grade de pontos e área 800x420. Cores via classes da paleta.
interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---
<svg viewBox="0 0 800 420" role="img" aria-label={label} class="block h-auto w-full" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern id={`dots-${id}`} width="24" height="24" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.6" class="fill-border" />
    </pattern>
  </defs>
  <rect width="800" height="420" class="fill-tag" />
  <rect width="800" height="420" fill={`url(#dots-${id})`} />
  <slot />
</svg>
