---
import { t } from "../i18n/pt";
import { banners } from "./banners";

interface Props {
  slug: string;
  title: string;
  summary: string;
  note: string;
}
const { slug, title, summary, note } = Astro.props;
const Banner = banners[slug];
---
<article data-mystery-card class="card flex w-full flex-col rounded-2xl border-2 border-dashed border-border p-2">
  {Banner && <div class="overflow-hidden rounded-xl"><Banner /></div>}
  <div class="p-4">
    <div class="flex flex-wrap items-center gap-3">
      <h3 class="font-display text-xl font-medium">{title}</h3>
      <span class="rounded-md bg-tag px-2 py-0.5 font-mono text-xs text-brown">{t.projects.building}</span>
    </div>
    <p class="mt-3 text-sm leading-relaxed text-muted">{summary}</p>
    <p class="mt-3 font-mono text-xs text-muted">{note}</p>
  </div>
</article>
