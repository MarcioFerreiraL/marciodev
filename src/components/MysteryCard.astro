---
import { t } from "../i18n/pt";

interface Props {
  title: string;
  summary: string;
  note: string;
}
const { title, summary, note } = Astro.props;
---
<article data-mystery-card class="card w-full flex flex-col justify-center rounded-2xl border-2 border-dashed border-border p-6">
  <div class="flex items-center gap-3">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-brown" stroke-width="1.8"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
    <h3 class="font-display text-xl font-medium">{title}</h3>
    <span class="rounded-md bg-tag px-2 py-0.5 font-mono text-xs text-brown">{t.projects.building}</span>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-muted">{summary}</p>
  <p class="mt-3 font-mono text-xs text-muted">{note}</p>
</article>
